@startuml s05a_sinif_oylama_turleri
!include ../../uml/_stil.iuml
skinparam nodesep 30
skinparam ranksep 40

package "Strategy + Template Method — oylama türleri" {
  class oylama <<modül>> {
    oy_ver(teklif, üye, seçim)
    sayim(teklif)
    sonuclandir(teklif) «şablon»
  }
  abstract class TeklifTuru {
    kod
    {abstract} secenekler()
    {abstract} sonuc_durumu(s)
    {abstract} uygula(s)
  }
  oylama ..> TeklifTuru : adımları çağırır
  TeklifTuru <|-- FikirTuru
  TeklifTuru <|-- EvetHayirTuru
  EvetHayirTuru <|-- MesajGizleme
  EvetHayirTuru <|-- KonuKaldirma
  EvetHayirTuru <|-- Uzmanlik
  EvetHayirTuru <|-- Yonetmelik
}
@enduml
