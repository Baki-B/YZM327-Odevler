@startuml s08_sirali_oy_verme
!include ../../uml/_stil.iuml
hide footbox
participant "Üye" as U
participant "Web katmanı" as W
participant "oylama" as O
participant "uygunluk" as Y
participant "Veritabanı" as V
participant "defter" as D

U -> W : POST /oylama/12/oy
W -> W : yazma kilidini al
W -> O : oy_ver(teklif, üye, seçim)
O -> Y : oy_agirligi(üye)
Y --> O : 0, 1 ya da 10
alt ağırlık = 0 (gözlemci)
  O --> U : "Bu konuda gözlemcisin"
else oy hakkı var
  O -> O : makbuz ve taahhüt üret
  O -> V : oyu kaydet (oylama açıksa)
  W -> V : COMMIT
  V -> D : commit olayı
  D -> D : üç düğüme yaz
  O --> U : makbuz kodu
end
@enduml
