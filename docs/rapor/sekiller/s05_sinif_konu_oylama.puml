@startuml s05_sinif_konu_oylama
!include ../../uml/_stil.iuml
skinparam nodesep 30
skinparam ranksep 45

package "State — konu durumları" {
  abstract class KonuDurumu {
    kod
    sonrakiler
    fikir_yazilabilir(konu)
    gecis_dogrula(yeni)
  }
  KonuDurumu <|-- Tartisma
  KonuDurumu <|-- Oylama
  KonuDurumu <|-- KararaBaglandi
  KonuDurumu <|-- Sonucsuz
  KonuDurumu <|-- Kaldirildi
}

package "Strategy + Template Method — oylama türleri" {
  class oylama <<modül>> {
    oy_ver(teklif, üye, seçim)
    sayim(teklif)
    sonuclandir(teklif) «şablon»
  }
  abstract class TeklifTuru {
    kod
    {abstract} secenekler()
    {abstract} sonuc_durumu(s)
    {abstract} uygula(s)
  }
  oylama ..> TeklifTuru : adımları çağırır
  TeklifTuru <|-- FikirTuru
  TeklifTuru <|-- EvetHayirTuru
  EvetHayirTuru <|-- MesajGizleme
  EvetHayirTuru <|-- KonuKaldirma
  EvetHayirTuru <|-- Uzmanlik
  EvetHayirTuru <|-- Yonetmelik
}
note bottom of oylama
  sonuclandir(): sayım → sonuç durumu → uygula.
  Adım sırası sabit; türe özgü adımlar alt sınıftan gelir.
end note
Yonetmelik -[hidden]down- KonuDurumu
Uzmanlik -[hidden]down- KonuDurumu
@enduml
